{
  "name": "okx-virtual-trader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts src/server/app.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "package:win": "pnpm build && node scripts/package-win.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "ccxt": "^4.5.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "technicalindicators": "^3.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "fflate": "0.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
